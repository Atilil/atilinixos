snippet snip_swarm Service swarm
  services:
    ${1:servicename}:
      image: ${2:pasteimage}
      environment:
        - TZ=Europe/Paris
        # - PUID=1000
        # - PGID=1000
        # - DB_PASSWORD_FILE=/run/secrets/mon_secret
      # secrets:
      #   - mon_secret
      volumes:
        - type: volume
          source: ${3:volumename}
          target: ${4:volumetarget}
      networks:
        traefik-public:
          aliases:
            - $1
      deploy:
        replicas: ${5:1}
        placement:
          constraints:
            - node.labels.tier == ${6:tier} # apps|infra|media|database
        labels:
          - traefik.enable=true
          - traefik.http.routers.$1.rule=Host(\`$1.macopla.com\`)
          - traefik.http.routers.$1.entrypoints=websecure
          - traefik.http.services.$1.loadbalancer.server.port=${7:portnumber}
          # enlever commentaire si local-only et/ou sso proxy authentik
          # - traefik.http.routers.$1.middlewares=authentik-proxy@swarm,local-only@file
        resources:
          limits:
            memory: ${8:256M}
        update_config:
          parallelism: 1
          delay: 10s
          failure_action: rollback
          order: start-first
        rollback_config:
          parallelism: 1
        restart_policy:
          condition: on-failure
          delay: 30s
          max_attempts: 0
          window: 300s
      healthcheck:
        test: ${9:adefinir}
        interval: 30s
        timeout: 5s
        retries: 3
        start_period: ${10:60s}
  # secrets externes (docker secret / Komodo) — si utilisés ci-dessus :
  # secrets:
  #   mon_secret:
  #     external: true
  volumes:
    $3:
      driver_opts:
        type: none
        o: bind
        device: /data/gluster/$1/$3
  networks:
    traefik-public:
      external: true
  $0

snippet snip_swarm_internal Service swarm sans Traefik (worker, agent interne)
  ${1:servicename}:
    image: ${2:pasteimage}
    environment:
      - TZ=Europe/Paris
    networks:
      - ${3:networkname}
    deploy:
      replicas: ${4:1}
      placement:
        constraints:
          - node.labels.tier == ${5:tier} # apps|infra|media|database
      resources:
        limits:
          memory: ${6:256M}
      update_config:
        parallelism: 1
        delay: 10s
        failure_action: rollback
        order: ${7:stop-first}
      rollback_config:
        parallelism: 1
      restart_policy:
        condition: on-failure
        delay: 30s
        max_attempts: 0
        window: 300s
    healthcheck:
      test: ${8:adefinir}
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: ${9:60s}
  $0

snippet snip_postgresql DB PostgreSQL (une par stack, sur dozer)
  ${1:svc}-db:
    image: postgres:18.4-trixie
    environment:
      - POSTGRES_USER=${2:user}
      - POSTGRES_DB=${3:db}
      - POSTGRES_PASSWORD_FILE=/run/secrets/${4:svc_db_password}
    secrets:
      - $4
    volumes:
      - type: volume
        source: $1_db
        target: /var/lib/postgresql
    networks:
      - $1-db-net
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.labels.tier == database
      update_config:
        parallelism: 1
        order: stop-first
        failure_action: rollback
      rollback_config:
        parallelism: 1
      restart_policy:
        condition: on-failure
        delay: 30s
        window: 300s
      resources:
        limits:
          memory: ${5:256M}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $2 -d $3"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 30s
  secrets:
    $4:
      external: true
  volumes:
    $1_db:
      driver_opts:
        type: none
        o: bind
        device: /data/$1/db
  networks:
    $1-db-net:
  $0

snippet snip_mariadb DB MariaDB (une par stack, sur dozer)
  ${1:svc}-db:
    image: mariadb:12.3
    environment:
      - MARIADB_USER=${2:user}
      - MARIADB_DATABASE=${3:db}
      - MARIADB_PASSWORD_FILE=/run/secrets/${4:svc_db_password}
      - MARIADB_RANDOM_ROOT_PASSWORD=yes
    secrets:
      - $4
    volumes:
      - type: volume
        source: $1_db
        target: /var/lib/mysql
    networks:
      - $1-db-net
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.labels.tier == database
      update_config:
        parallelism: 1
        order: stop-first
        failure_action: rollback
      rollback_config:
        parallelism: 1
      restart_policy:
        condition: on-failure
        delay: 30s
        window: 300s
      resources:
        limits:
          memory: ${5:512M}
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 30s
  secrets:
    $4:
      external: true
  volumes:
    $1_db:
      driver_opts:
        type: none
        o: bind
        device: /data/$1/db
  networks:
    $1-db-net:
  $0

snippet snip_mongodb DB MongoDB (une par stack, sur dozer)
  ${1:svc}-db:
    image: mongo:7
    environment:
      - MONGO_INITDB_ROOT_USERNAME=${2:user}
      - MONGO_INITDB_DATABASE=${3:db}
      - MONGO_INITDB_ROOT_PASSWORD_FILE=/run/secrets/${4:svc_db_password}
    secrets:
      - $4
    volumes:
      - type: volume
        source: $1_db
        target: /data/db
    networks:
      - $1-db-net
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.labels.tier == database
      update_config:
        parallelism: 1
        order: stop-first
        failure_action: rollback
      rollback_config:
        parallelism: 1
      restart_policy:
        condition: on-failure
        delay: 30s
        window: 300s
      resources:
        limits:
          memory: ${5:512M}
    healthcheck:
      test: ["CMD-SHELL", "mongosh --quiet --eval 'db.runCommand({ping:1}).ok' | grep -q 1"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 30s
  secrets:
    $4:
      external: true
  volumes:
    $1_db:
      driver_opts:
        type: none
        o: bind
        device: /data/$1/db
  networks:
    $1-db-net:
  $0

snippet snip_redis DB Redis (secret via command, sur dozer)
  ${1:svc}-db:
    image: redis:8-alpine
    command: /bin/sh -c "redis-server --requirepass $$(cat /run/secrets/${2:svc_redis_password})"
    secrets:
      - $2
    volumes:
      - type: volume
        source: $1_redis
        target: /data
    networks:
      - $1-db-net
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.labels.tier == database
      update_config:
        parallelism: 1
        order: stop-first
        failure_action: rollback
      rollback_config:
        parallelism: 1
      restart_policy:
        condition: on-failure
        delay: 30s
        window: 300s
      resources:
        limits:
          memory: ${3:256M}
    healthcheck:
      test: ["CMD-SHELL", "redis-cli -a \"$$(cat /run/secrets/$2)\" --no-auth-warning ping | grep -q PONG"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 20s
  secrets:
    $2:
      external: true
  volumes:
    $1_redis:
      driver_opts:
        type: none
        o: bind
        device: /data/$1/redis
  networks:
    $1-db-net:
  $0
