_: {
  den.aspects.nvf.homeManager = {pkgs, ...}: {
    programs.nvf.settings.vim = {
      # Needed by the matugen.lua theme generated by Noctalia
      extraPlugins.base16-nvim.package = pkgs.vimPlugins.base16-nvim;

      luaConfigRC = {
        # Required for true colors in custom themes
        termguicolors = ''
          vim.opt.termguicolors = true
        '';

        # Reload transparency and the punctuation fix after each live Noctalia theme swap
        theme = ''
          local function fix_theme()
            vim.api.nvim_set_hl(0, "Normal",   { bg = "none" })
            vim.api.nvim_set_hl(0, "NormalNC", { bg = "none" })

            -- base16 sets NormalFloat to base00, identical to the editor: floats (hover, ui2 msg)
            -- blend in. base01 is the palette's next shade, so it follows live theme swaps.
            local colors = require('base16-colorscheme').colors
            vim.api.nvim_set_hl(0, "NormalFloat", { fg = colors.base05, bg = colors.base01 })

            local base0A = colors.base0A
            vim.api.nvim_set_hl(0, "TSPunctDelimiter", { fg = base0A })
            vim.api.nvim_set_hl(0, "TSPunctSpecial", { fg = base0A })
          end

          require('matugen').setup()
          fix_theme()

          local sig = vim.uv.new_signal()
          sig:start("sigusr1", vim.schedule_wrap(function()
            vim.defer_fn(fix_theme, 100)
          end))
        '';
      };
    };
  };
}
